{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": { "name": "MULTIPLICA", "version": "1.0.0", "theme": "neo-editorial" },
  "color": {
    "ink": { "950": "#111111", "800": "#292927", "600": "#5F5F5A" },
    "paper": { "50": "#F3F0E8", "100": "#E9E5DA", "0": "#FFFFFF" },
    "concrete": { "300": "#B8B8B2", "200": "#D4D2CA", "100": "#E4E1D8" },
    "vermilion": { "600": "#C92E1B", "500": "#E33B24", "100": "#FBE4DF" },
    "cobalt": { "700": "#2343D6", "500": "#3157FF", "100": "#E4E9FF" },
    "success": { "600": "#176B52", "100": "#DDF3EA" },
    "warning": { "600": "#9A5B00", "100": "#FFF0CE" }
  },
  "semantic": {
    "background": { "canvas": "{color.paper.50}", "surface": "{color.paper.0}", "inverse": "{color.ink.950}" },
    "text": { "primary": "{color.ink.950}", "secondary": "{color.ink.600}", "inverse": "{color.paper.0}", "link": "{color.cobalt.700}" },
    "border": { "default": "{color.concrete.200}", "strong": "{color.ink.950}", "focus": "{color.cobalt.500}" },
    "action": { "primary": "{color.vermilion.500}", "selected": "{color.cobalt.500}", "disabled": "{color.concrete.300}" },
    "status": { "success": "{color.success.600}", "warning": "{color.warning.600}", "danger": "{color.vermilion.600}" }
  },
  "space": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
  "radius": { "sm": "6px", "md": "10px", "lg": "16px", "pill": "999px" },
  "shadow": { "float": "0 12px 36px rgba(17,17,17,.14)", "card": "0 1px 0 rgba(17,17,17,.08)" },
  "font": {
    "family": { "display": "Archivo, Arial, sans-serif", "body": "Inter, Arial, sans-serif" },
    "size": { "xs": "12px", "sm": "14px", "md": "16px", "lg": "20px", "xl": "28px", "2xl": "40px", "3xl": "56px" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "black": 900 },
    "lineHeight": { "tight": 1.05, "title": 1.15, "body": 1.5 }
  },
  "motion": { "fast": "120ms", "base": "200ms", "slow": "320ms", "ease": "cubic-bezier(.2,.8,.2,1)" },
  "layout": { "sidebarCollapsed": "72px", "sidebarExpanded": "272px", "dockHeight": "64px", "contentMax": "1440px", "touchMin": "44px" },
  "breakpoint": { "tablet": "768px", "desktop": "1180px" }
}

