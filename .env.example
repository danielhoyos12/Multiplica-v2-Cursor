# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Optional: direct (non-pooled) URL for migrations if pooler/IPv6 fails
# DATABASE_URL_DIRECT=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Environment label: local | staging | production
# Verify/fixture scripts refuse APP_ENV=production
APP_ENV=local

# Optional: Playwright
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_SKIP=1

# Optional: Phase 5 E2E (generated by scripts/provision-e2e-users.ts → .env.e2e.local)
# E2E_SUPERADMIN_EMAIL=
# E2E_SUPERADMIN_PASSWORD=
# E2E_LEADER_GENERAL_EMAIL=
# E2E_LEADER_GENERAL_PASSWORD=
# E2E_LEADER_EMAIL=
# E2E_LEADER_PASSWORD=
# E2E_STAFF_EMAIL=
# E2E_STAFF_PASSWORD=
