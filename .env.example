# Public (browser-safe) — Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login

# Server-only — never prefix with NEXT_PUBLIC_
CLERK_SECRET_KEY=sk_test_...

# Postgres (Supabase or any Postgres) — data plane only, not Auth
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Optional: direct (non-pooled) URL for migrations if pooler/IPv6 fails
# DATABASE_URL_DIRECT=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Environment label: local | staging | production
# Verify/fixture scripts refuse APP_ENV=production
APP_ENV=local

# Optional: Playwright
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_SKIP=1

# Optional: Convex local development (anonymous / local backend)
# Generated by: CONVEX_AGENT_MODE=anonymous npx convex dev
# CONVEX_DEPLOYMENT=anonymous:anonymous-...
# NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
# NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Optional: Phase 5 E2E (provision against Clerk + DB)
# E2E_SUPERADMIN_EMAIL=
# E2E_SUPERADMIN_PASSWORD=
# E2E_LEADER_GENERAL_EMAIL=
# E2E_LEADER_GENERAL_PASSWORD=
# E2E_LEADER_EMAIL=
# E2E_LEADER_PASSWORD=
# E2E_STAFF_EMAIL=
# E2E_STAFF_PASSWORD=
