# Public — Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Public — Convex (required data plane)
# Local: CONVEX_AGENT_MODE=anonymous npx convex dev
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Server-only — never prefix with NEXT_PUBLIC_
CLERK_SECRET_KEY=sk_test_...
# Clerk Frontend API URL / JWT issuer (Convex Dashboard env + local docs)
# Example: https://boss-gull-2637.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
CONVEX_DEPLOYMENT=anonymous:anonymous-local
# CONVEX_DEPLOY_KEY=  # cloud deploys only

# Environment label: local | staging | production
# Verify/fixture scripts refuse APP_ENV=production
APP_ENV=local

# Optional interim Postgres for modules not yet on Convex — NEVER *.supabase.co
# DATABASE_URL=postgresql://user:pass@host/db

# Optional: Playwright
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# PLAYWRIGHT_SKIP=1

# Optional: Phase 5 E2E (provision against Clerk → .env.e2e.local)
# E2E_SUPERADMIN_EMAIL=
# E2E_SUPERADMIN_PASSWORD=
# E2E_LEADER_GENERAL_EMAIL=
# E2E_LEADER_GENERAL_PASSWORD=
# E2E_LEADER_EMAIL=
# E2E_LEADER_PASSWORD=
# E2E_STAFF_EMAIL=
# E2E_STAFF_PASSWORD=
